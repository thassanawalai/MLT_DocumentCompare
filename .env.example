# Copy this file to .env on the Ubuntu server. Do not commit .env.
#
# If Ollama runs directly on the same Ubuntu host, use the Docker host gateway.
# If it runs on another machine, replace with its private URL, for example
# http://10.0.0.25:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
